NODE_ENV=development
PORT=4000
# Leave blank only for development: a persistent local MongoDB process starts automatically.
# For installed MongoDB or Docker use mongodb://127.0.0.1:27017/doctor_tracker
# Production requires a hosted MongoDB URI (for example MongoDB Atlas).
MONGODB_URI=
FRONTEND_ORIGIN=http://localhost:3000
# Production: generate a random secret of at least 32 characters.
SESSION_SECRET=
ADMIN_EMAIL=admin@doctortracker.demo
ADMIN_NAME=Alex Morgan
# Required for initial production admin creation; at least 12 characters.
ADMIN_PASSWORD=
# Only explicit true creates synthetic sample doctors/patients.
SEED_DEMO=false
